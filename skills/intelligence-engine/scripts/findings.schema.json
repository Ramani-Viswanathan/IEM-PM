{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IEM-PM Canonical Findings v1.1.0",
  "description": "Machine-readable single source of truth for PMO Data Gap Audit",
  "type": "object",
  "required": [
    "audit_id",
    "schema_version",
    "charter_version",
    "generated_at",
    "baseline",
    "evidence_summary",
    "findings",
    "intelligence_indicators",
    "reporting_integrity_score"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "pattern": "^IEM-[0-9]{8}-[A-Z0-9]{6}$",
      "description": "Unique audit run identifier: IEM-YYYYMMDD-XXXXXX"
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.1.0"]
    },
    "charter_version": {
      "type": "string",
      "description": "Version of PMO Data Charter used"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when canonical JSON was generated"
    },
    "baseline": {
      "type": "object",
      "required": ["standards_declared", "artifacts_examined", "scope"],
      "properties": {
        "standards_declared": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "List of standards org claims to follow"
        },
        "artifacts_examined": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact_id", "artifact_name", "source_path", "checksum"],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^ART-[0-9]{3}$"
              },
              "artifact_name": { "type": "string" },
              "source_path": { "type": "string" },
              "checksum": {
                "type": "string",
                "description": "SHA-256 of artifact at time of audit, or 'computed'"
              }
            }
          }
        },
        "scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Audit scope: Projects, Programs, Portfolios, PMO"
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "required": ["total_artifacts", "total_fields_mapped", "coverage_percentage"],
      "properties": {
        "total_artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "total_fields_mapped": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "gap_type",
          "root_origin",
          "description",
          "evidence",
          "standard_reference",
          "severity",
          "impact",
          "recommended_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FIND-[0-9]{4}$"
          },
          "gap_type": {
            "type": "string",
            "enum": [
              "Missing",
              "Ignored",
              "Disconnected",
              "Untrusted",
              "Underutilized",
              "Misclassified",
              "Divergent"
            ]
          },
          "root_origin": {
            "type": "string",
            "enum": [
              "Capture",
              "Integration",
              "Definition / Taxonomy",
              "Ownership",
              "Process / Cadence",
              "Tooling",
              "Behavior"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "description": "What was found and why it matters"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["artifact_id", "location", "quote_or_absence"],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "pattern": "^ART-[0-9]{3}$"
                },
                "location": {
                  "type": "string",
                  "description": "Sheet name, page, line, or cell reference"
                },
                "quote_or_absence": {
                  "type": "string",
                  "description": "Direct quote from artifact, or explicit statement of absence"
                }
              }
            }
          },
          "standard_reference": {
            "type": "object",
            "required": ["standard", "identifier"],
            "properties": {
              "standard": {
                "type": "string",
                "description": "e.g., PMBOK7, PRINCE2, Internal-PMM-v2"
              },
              "clause": {
                "type": "string",
                "description": "Clause or section reference"
              },
              "identifier": {
                "type": "string",
                "description": "Specific process ID or practice ID"
              },
              "summary": {
                "type": "string",
                "description": "Brief summary of requirement (never full text)"
              }
            }
          },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1=Cosmetic, 5=Critical delivery threat"
          },
          "impact": {
            "type": "string",
            "description": "Narrative impact on delivery capability"
          },
          "recommended_action": {
            "type": "string"
          },
          "intelligence_dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Visibility",
                "Integrity",
                "Connectivity",
                "Governance",
                "Predictability",
                "Decision Quality",
                "Continuous Improvement"
              ]
            },
            "description": "Which intelligence dimensions this finding affects"
          }
        }
      }
    },
    "intelligence_indicators": {
      "type": "object",
      "description": "Narrative diagnostic labels only. Never scored or weighted here.",
      "required": [
        "visibility",
        "integrity",
        "connectivity",
        "governance",
        "predictability",
        "decision_quality",
        "continuous_improvement"
      ],
      "properties": {
        "visibility": { "type": "string" },
        "integrity": { "type": "string" },
        "connectivity": { "type": "string" },
        "governance": { "type": "string" },
        "predictability": { "type": "string" },
        "decision_quality": { "type": "string" },
        "continuous_improvement": { "type": "string" }
      }
    },
    "reporting_integrity_score": {
      "type": "object",
      "required": ["score", "methodology", "version"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Deterministic score based on gap profile"
        },
        "methodology": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}